<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 SplashScreen API (platform attributes, no extra library): midnight navy + Tsuki's portrait. -->
    <style name="Theme.HonorPhoneAgent.Launch" parent="Theme.HonorPhoneAgent">
        <item name="android:windowSplashScreenBackground">@color/splash_bg</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/ic_launcher_bg</item>
        <item name="android:windowSplashScreenAnimationDuration">300</item>
    </style>
</resources>
